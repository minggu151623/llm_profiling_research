{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pilot v0 label record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "branch_id",
    "workload_id",
    "taken_count",
    "fallthrough_count",
    "p_taken"
  ],
  "properties": {
    "schema_version": {
      "const": "v0"
    },
    "branch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}:[0-9]+:[0-9]+$"
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "taken_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "fallthrough_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "p_taken": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
